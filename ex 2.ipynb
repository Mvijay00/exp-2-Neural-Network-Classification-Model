   "execution_count": 30,
   "id": "813b6e93-8358-4ac2-8975-6319903e209f",
   "metadata": {},
   "outputs": [],
   "source": [
    "y_train = torch.LongTensor(y_train)\n",
    "y_test = torch.LongTensor(y_test)"
   ]
  },
